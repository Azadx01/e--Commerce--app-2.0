# ==========================================
# ReVivo Platform - Local Development Environment
# ==========================================

# 1. Environment & Core
ENVIRONMENT=development
PROJECT_NAME="ReVivo Local Dev"
API_V1_STR=/api/v1

# 2. Database (PostgreSQL or SQLite for local dev)
POSTGRES_USER=revivo_user
POSTGRES_PASSWORD=devpassword123
POSTGRES_DB=revivo_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://revivo_user:devpassword123@localhost:5432/revivo_db
# Or local SQLite fallback:
# DATABASE_URL=sqlite:///./revivo.db

# 3. Redis / Caching
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# 4. Authentication & Security
# WARNING: Change for non-development environments (minimum 32 random characters)
JWT_SECRET=revivo_dev_secret_key_9f38bc1a4e21a8d05e26b1c7f0d34a5b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 5. Payment Architecture (Sandbox Mode)
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_MODE=true
PLATFORM_FEE_PERCENTAGE=15.0

# 6. Database Migrations
RUN_MIGRATIONS=true

# 7. Frontend URLs for CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://127.0.0.1:3000","http://127.0.0.1:8081"]
