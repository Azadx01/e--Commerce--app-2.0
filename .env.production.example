# ==========================================
# ReVivo Platform - Production Environment Template
# ==========================================
# Instructions:
# 1. Copy this file to .env.production on your production server:
#    cp .env.production.example .env.production
# 2. Fill in secure, randomly generated secrets.
# 3. Restrict permissions: chmod 600 .env.production
# 4. NEVER commit .env.production to version control.
# ==========================================

# 1. Server & Environment
ENVIRONMENT=production
PROJECT_NAME="ReVivo Enterprise Platform"
API_V1_STR=/api/v1

# 2. Production PostgreSQL Database
# Replace placeholders with your managed DB credentials (e.g. AWS RDS / Supabase / Neon)
POSTGRES_USER=revivo_prod_admin
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=revivo_production
DATABASE_URL=postgresql+psycopg://revivo_prod_admin:GENERATE_STRONG_RANDOM_PASSWORD_HERE@db:5432/revivo_production
# Pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# 3. Production Redis (with Authentication)
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_HERE
REDIS_URL=redis://:GENERATE_STRONG_REDIS_PASSWORD_HERE@redis:6379/0

# 4. Authentication & Security (MANDATORY >= 32 CHARACTERS)
# Generate with: openssl rand -hex 32
JWT_SECRET=GENERATE_MIN_32_CHAR_CRYPTOGRAPHIC_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# 5. Payment Gateway Integration
PAYMENT_PROVIDER=stripe
PAYMENT_SANDBOX_MODE=false
PLATFORM_FEE_PERCENTAGE=15.0
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
# Or Razorpay:
# RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# 6. S3-Compatible Object Storage (Device Images / Invoices)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=revivo-production-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
STORAGE_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# 7. Monitoring & Error Tracking
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
LOG_LEVEL=INFO

# 8. Production CORS & Allowed Origins
BACKEND_CORS_ORIGINS=["https://admin.revivo.internal","https://app.revivo.internal","https://revivo.internal"]

# 9. Startup Migrations
RUN_MIGRATIONS=true
